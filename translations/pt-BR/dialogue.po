#: Bazaar/Casino/Casper Colikke Mailanen
#, fuzzy
msgctxt "dlg.426.14.text"
msgid "Money\\,\\,, of course."
msgstr "Dinheiro\\,\\,, é claro."

#: Bazaar/Casino/Casper Colikke Mailanen
#, fuzzy
msgctxt "dlg.426.15.text"
msgid "I will\\, pay\\, a hefty sum\\, if you agree to help."
msgstr "Eu vou\\, pagar\\, uma bela quantia\\, se você topar ajudar."

#: Bazaar/Casino/Casper Colikke Mailanen
#, fuzzy
msgctxt "dlg.426.16.text"
msgid "And\\, I can\\, even pay\\, half upfront."
msgstr "E\\, posso até\\, pagar\\, metade adiantado."

#: Bazaar/Casino/Casper Colikke Mailanen
#, fuzzy
msgctxt "dlg.426.18.text"
msgid "I'll do it. Where is Mailanen?"
msgstr "Eu topo. Onde está o Mailanen?"

#: Bazaar/Casino/Casper Colikke Mailanen
#, fuzzy
msgctxt "dlg.426.19.text"
msgid "Excellent!\\,\\, I'll\\, fill you in\\, on the details\\,\\,, but\\, before that..."
