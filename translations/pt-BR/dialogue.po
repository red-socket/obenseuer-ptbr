#: Tenement/Kolhola/Telemarketer_Doorphone
#, fuzzy
msgctxt "dlg.128.2.text"
msgid "I want to cancel my OS-magazine subscription"
msgstr "Quero cancelar minha assinatura da revista Esgoto Aberto"

#: Tenement/Kolhola/Telemarketer_Doorphone
#, fuzzy
msgctxt "dlg.128.3.text"
msgid "I want to make a complaint"
