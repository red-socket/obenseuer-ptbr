msgid "Fine <color=#9b8a35>quack!</color>!\\,\\,\\, It\\, still seems to be doing just fine...\\,\\,\\,\\, just give it a new home\\, where it can <color=#9b8a35>quack!</color> in\\, peace.\\,\\,\\, And now..."
msgstr "Tá bom <color=#9b8a35>quá!</color>!\\,\\,\\, Ele\\, ainda parece estar muito bem...\\,\\,\\,\\, só dê a ele um novo lar\\, onde ele possa <color=#9b8a35>quá!</color> em\\, paz.\\,\\,\\, E agora..."

#: Tenement/Speakeasy/Mr. Blue Duck
#, fuzzy
msgctxt "dlg.93.73.menu"
msgid "<color=#9b8a35>Quack?</color>\\,\\,\\, Are you <color=#9b8a35>quack</color>?\\,\\,\\, It would make you very <color=#9b8a35>quack quack</color> happy <color=#9b8a35>quack!</color> "
msgstr "<color=#9b8a35>Quá?</color>\\,\\,\\, Você tem <color=#9b8a35>quá</color>?\\,\\,\\, Ia te deixar muito <color=#9b8a35>quá quá</color> feliz <color=#9b8a35>quá!</color> "

#: Tenement/Speakeasy/Mr. Blue Duck
#, fuzzy
msgctxt "dlg.93.74.menu"
msgid "No <color=#9b8a35>quack!</color>\\,\\, You can't keep both <color=#9b8a35>quacks!</color>\\,\\,\\, Just keep that <color=#9b8a35>quack</color>...\\,\\,\\,\\, it seems to be fine so I don't need it now!\\,\\,\\,\\, <color=#9b8a35>Quack quack quack quack</color>..."
msgstr "Nada de <color=#9b8a35>quá!</color>\\,\\, Você não pode ficar com os dois <color=#9b8a35>quás!</color>\\,\\,\\, Fica com esse <color=#9b8a35>quá</color>...\\,\\,\\,\\, ele parece estar bem, então não preciso dele agora!\\,\\,\\,\\, <color=#9b8a35>Quá quá quá quá</color>..."

#: Tenement/Speakeasy/Mr. Blue Duck
#, fuzzy
msgctxt "dlg.93.75.menu"
msgid "Yeah, I'm sure"
