msgstr "Quero assinar a revista Esgoto Aberto"

#: Tenement/Kolhola/Telemarketer_Doorphone
#, fuzzy
msgctxt "dlg.128.5.text"
msgid "I demand to see the manager!"
msgstr "Exijo falar com o gerente!"

#: Tenement/Kolhola/Telemarketer_Doorphone
#, fuzzy
msgctxt "dlg.128.6.text"
