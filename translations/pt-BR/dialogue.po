msgctxt "dlg.66.124.text"
msgid "[lua(Variable[\"PlayerFirstName\"])]...\\,\\, I\\, don't know you.\\,\\, What do you want?\\,\\, I hope you're not one of those mushroom sellers."
msgstr "[lua(Variable[\"PlayerFirstName\"])]...\\,\\, Não\\, te conheço.\\,\\, O que você quer?\\,\\, Espero que não seja um desses vendedores de cogumelo."

