#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.3.text"
msgid "Go sit on the chair."
msgstr "Vá se sentar na cadeira."

#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.5.text"
msgid "... it takes about\\,\\, a couple of days\\, for the passport to arrive by mail."
msgstr "... o passaporte leva uns\\,\\, dois dias\\, para chegar pelo correio."

#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.6.text"
msgid "You can now\\, leave...\\,\\, so I can get to work."
msgstr "Agora você\\, pode ir...\\,\\, para eu poder trabalhar."

#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.7.text"
msgid "Yeah?"
msgstr "Sim?"

#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.8.text"
msgid "What happened?"
msgstr "O que aconteceu?"

#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.9.text"
msgid "Okay (Leave)"
msgstr "Tá bom (Sair)"

#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.10.text"
msgid "What do you mean?"
msgstr "Como assim?"

#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.11.text"
msgid "We just\\,\\, took a photo for your passport."
msgstr "A gente só\\,\\, tirou uma foto para o seu passaporte."

#: Tenement/Kolhola/Eliana Passmore Camera
#, fuzzy
msgctxt "dlg.178.12.text"
