msgstr "Tudo bem...\\,\\,\\, vou denunciar você\\,\\, à polícia."

#: Tenement/Kolhola/Meri Haka
#, fuzzy
msgctxt "dlg.146.11.text"
msgid "Good.\\,\\,\\, Go get it\\,\\, before I call the police."
msgstr "Ótimo.\\,\\,\\, Vá buscar\\,\\, antes que eu chame a polícia."

#: Tenement/Kolhola/Meri Haka
#, fuzzy
msgctxt "dlg.146.12.text"
msgid "Haka... Niemi? My memory, you know, it's not so great."
msgstr "Haka... Niemi? Minha memória, sabe, não anda lá essas coisas."

#: Tenement/Kolhola/Meri Haka
#, fuzzy
msgctxt "dlg.146.13.text"
