msgid "You're the best.\\,\\, Thanks!"
msgstr "Você é {{o melhor|a melhor}}.\\,\\, Valeu!"

#: Tenement/Kolhola/Telemarketer_Doorphone
#, fuzzy
msgctxt "dlg.128.1.text"
